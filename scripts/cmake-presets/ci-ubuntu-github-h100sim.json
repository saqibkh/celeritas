{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": ["scripts/cmake-presets/ci-ubuntu-github.json"],
  "configurePresets": [
    {
      "name": "h100sim",
      "description": "FINAL: ORANGE + Geant4 from spack, CUDA PTX for a simulated H100",
      "inherits": ["orange", ".cuda"],
      "cacheVariables": {
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_covfie": { "type": "BOOL", "value": "ON" },
        "CMAKE_CUDA_ARCHITECTURES": { "type": "STRING", "value": "90-virtual" },
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda-13.0/bin/nvcc",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CUDA_RUNTIME_LIBRARY": "Shared",
        "CUDAToolkit_ROOT": "/usr/local/cuda-13.0",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -Werror -Wno-error=deprecated-declarations -isystem /usr/local/cuda-13.0/targets/x86_64-linux/include/cccl",
        "CMAKE_UNITY_BUILD": { "type": "BOOL", "value": "ON" }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "h100sim",
      "configurePreset": "h100sim",
      "inherits": "base",
      "jobs": 3
    }
  ],
  "testPresets": [
    {
      "name": "h100sim",
      "configurePreset": "h100sim",
      "inherits": ".base",
      "execution": {
        "jobs": 3,
        "timeout": 1800
      },
      "output": {
        "outputJUnitFile": "$env{GITHUB_WORKSPACE}/test-output/ctest/all.xml"
      }
    }
  ]
}
